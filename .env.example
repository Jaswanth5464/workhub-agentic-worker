# ── LLM ────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Fallback chain (comma-separated): tried in order on 429/timeout
LLM_FALLBACK_PROVIDERS=groq,gemini,ollama

# Gemini-specific (used when provider=gemini or fallback hits gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama-specific (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Ports ──────────────────────────────────────────
WORKER_PORT=8000
VENDORHUB_PORT=8001
ACMEFINANCE_PORT=8002

# ── URLs (used by tools and verifier) ──────────────
VENDORHUB_URL=http://localhost:8001
ACMEFINANCE_URL=http://localhost:8002

# ── Security ───────────────────────────────────────
ALLOWED_DOMAINS=localhost:8001,localhost:8002

# ── Runs ───────────────────────────────────────────
RUNS_DIR=runs

# ── Budgets (defaults, overridable per contract) ───
DEFAULT_BUDGET_MAX_STEPS=25
DEFAULT_BUDGET_MAX_LLM_CALLS=40
DEFAULT_BUDGET_MAX_TOOL_CALLS=60
DEFAULT_BUDGET_MAX_RETRIES=2
DEFAULT_BUDGET_MAX_SECONDS=180

# ── Approval ───────────────────────────────────────
HIGH_VALUE_THRESHOLD=500000
